{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Local development bindings. Freebuff Sites attaches the real DB binding on
  // deploy (sites_add_storage) and injects the FREEBUFF_* vars.
  //
  // Local secrets come from `.env` (see .env.example): KOBA_ENGINE_URL and
  // KOBA_ENGINE_API_KEY point the Worker at koba_engine. Do not add a
  // `.dev.vars` file; its presence stops Wrangler from reading `.env` and
  // `.env.local`.
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-chat", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "observability": { "enabled": true }
}
